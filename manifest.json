{
  "manifest_version": 3,
  "name": "JobTrack AI",
  "version": "0.1.0",
  "description": "Detects confirmed job application submissions and logs them to your Google Sheet.",
  "permissions": ["identity", "storage", "alarms", "notifications"],
  "host_permissions": [
    "https://sheets.googleapis.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": { "service_worker": "src/background/background.js" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["src/shared/util.js", "src/content/adapters.js", "src/content/content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_title": "JobTrack AI", "default_popup": "src/popup/popup.html" },
  "icons": { "48": "icon.png", "128": "icon.png" },
  "options_page": "src/options/options.html",
  "oauth2": {
    "client_id": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets"
    ]
  }
}
